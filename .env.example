# ─── Gemini AI API ────────────────────────────────────────────────────────────
# Required: Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Custom Search API (Optional) ──────────────────────────────────────
# When set, articles are searched BEFORE Gemini analysis for richer context.
# Step 1: Articles found → Gemini analyzes with article context
# Step 2: No articles found → Gemini uses its own knowledge
#
# Get API Key: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your_google_api_key_here
# Create Search Engine: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ─── Email Configuration (Optional) ──────────────────────────────────────────
# SMTP settings for sending analysis report emails.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# Default recipients (comma-separated). Additional recipients can be added via UI.
EMAIL_TO=recipient1@example.com,recipient2@example.com
