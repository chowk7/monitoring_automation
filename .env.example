# ─── Gemini AI API ────────────────────────────────────────────────────────────
# Required: Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── News Search APIs (Optional — adds more article sources) ──────────────────
# News search pipeline: Yahoo Finance (always on) → NewsAPI → Google CSE → Naver → Gemini analysis
# If articles found: Gemini uses articles + own knowledge for analysis
# If no articles:   Gemini uses its own knowledge/search capabilities
#
# [NewsAPI.org] — Free tier: 100 req/day
# Get API Key: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here
#
# [Google Custom Search API] — Free tier: 100 queries/day
# Get API Key: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your_google_api_key_here
# Create Search Engine: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your_custom_search_engine_id_here
#
# [Naver Search API] — Free tier: 25,000 req/day (Korean news, 한국 종목/지수에 효과적)
# 애플리케이션 등록: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# ─── Email Configuration (Optional) ──────────────────────────────────────────
# SMTP settings for sending analysis report emails.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# Default recipients (comma-separated). Additional recipients can be added via UI.
EMAIL_TO=recipient1@example.com,recipient2@example.com

# ─── Google Cloud Storage (Optional) ─────────────────────────────────────────
# Persists settings.json/tickers.csv and saved analysis results (date-indexed)
# across restarts and container instances.
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# ─── Fundamentals Data APIs (Optional — enables Excel export data) ───────────
# [DART OpenAPI] — 상장기업 재무제표 (Korea only, historical actuals only).
# Get key: https://opendart.fss.or.kr/
DART_API_KEY=your_dart_api_key_here
#
# [KRX 정보데이터시스템 OpenAPI] — 국내 시가총액/주가/52주 데이터 (Korea only).
# Get key: https://data.krx.co.kr/
KRX_API_KEY=your_krx_api_key_here
#
# [Financial Modeling Prep] — 해외 종목 fundamentals + 모든 종목 FY 예상치.
# Get key: https://financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here
#
# How long (seconds) to cache a ticker's fundamentals before re-fetching from
# the APIs above. Default 6 hours — avoids burning paid-API quota on repeated
# manual runs.
FUNDAMENTALS_CACHE_TTL_SECONDS=21600
